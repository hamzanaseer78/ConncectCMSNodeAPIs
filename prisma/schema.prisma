generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  admin
  manager
  technician
}

enum TechnicianAffiliation {
  in_house
  third_party
}

enum QuotationStatus {
  created
  sent
  approved
  rejected
}

enum CpairReceiveStatus {
  pending
  partially_received
  all_received
}

enum CpairIssueStatus {
  pending
  partially_issued
  issued
}

enum UserAttendanceStatus {
  checked_in
  on_break
  checked_out
}

enum UserAttendanceAction {
  check_in
  check_out
  break_in
  break_out
}

enum FaceApprovalRequestStatus {
  pending
  approved
  rejected
}

enum AnnouncementAudience {
  all
  technician
  manager
  admin
}

enum UserActivityAction {
  create
  update
  delete
  assign
  unassign
  status_change
  login
  logout
  password_changed
  settings_updated
  invite
  activate
  deactivate
  block
  unblock
  approve
  reject
  complete
  resolve
  submit
  upload
  other
}

model areas {
  recno                            Int            @id @default(autoincrement())
  tenantid                         Int?
  name                             String?
  cityid                           Int?           @db.SmallInt
  createdby                        Int?
  createdat                        DateTime?      @db.Timestamp(6)
  lastupdatedby                    Int?
  lastupdatedat                    DateTime?      @db.Timestamp(6)
  isactive                         Boolean?
  cities                           cities?        @relation(fields: [cityid], references: [recno], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_cities")
  users_areas_createdbyTousers     users?         @relation("areas_createdbyTousers", fields: [createdby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_createdby")
  users_areas_lastupdatedbyTousers users?         @relation("areas_lastupdatedbyTousers", fields: [lastupdatedby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_lastupdatedby")
  organizations                    organizations? @relation(fields: [tenantid], references: [tenantid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_tenant")
  customers                        customers[]
  customeraddresses                customeraddresses[]
  job                              job[]

  @@index([recno], map: "idx_jsl_areas")
}

model branches {
  branchid                            Int                     @id @default(autoincrement())
  tenantid                            Int?
  name                                String?
  phoneno                             String?
  email                               String?
  web                                 String?
  country                             Int?
  city                                Int?
  area                                Int?
  address                             String?
  address2                            String?
  logourl                             String?
  isactive                            Boolean?
  createdby                           Int?
  createdat                           DateTime?               @db.Timestamp(6)
  lastupdatedby                       Int?
  lastupdatedat                       DateTime?               @db.Timestamp(6)
  users_branches_createdbyTousers     users?                  @relation("branches_createdbyTousers", fields: [createdby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_createdby")
  users_branches_lastupdatedbyTousers users?                  @relation("branches_lastupdatedbyTousers", fields: [lastupdatedby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_lastupdatedby")
  organizations                       organizations?          @relation(fields: [tenantid], references: [tenantid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_tenant")
  customers                           customers[]
  customeraddresses                   customeraddresses[]
  job                                 job[]
  jobaddonproducts                    jobaddonproducts[]
  jobassignmentlog                    jobassignmentlog[]
  jobattachments                      jobattachments[]
  jobcategories                       jobcategories[]
  jobcustomerremarkslog               jobcustomerremarkslog[]
  jobcustomerfeedback                 jobcustomerfeedback[]
  jobdetails                          jobdetails[]
  jobgroups                           jobgroups[]
  jobproducts                         jobproducts[]
  jobservices                         jobservices[]
  jobstatuslog                        jobstatuslog[]
  jobquotationstatuslog               jobquotationstatuslog[]
  jobsubcategories                    jobsubcategories[]
  jobtravelhistory                    jobtravelhistory[]
  jobworklhistory                     jobworklhistory[]
  products                            products[]
  erpproducts                         erpproducts[]
  userorganizations                   userorganizations[]
  userpolicies                        userpolicies[]
  userrights                          userrights[]
  userlocations                       userlocations[]
  userattendancesession               userattendancesession[]
  userattendancelog                   userattendancelog[]
  announcements                       announcements[]
  jobapprovalsettings                 jobapprovalsettings[]
  faceapprovalsettings                faceapprovalsettings[]
  faceapprovalrequests                faceapprovalrequests[]
  jobquotationsettings                jobquotationsettings[]
  jobcashsettings                     jobcashsettings[]
  jobcollections                      jobcollections[]
  jobexpenses                         jobexpenses[]
  jobcpairsummary                     jobcpairsummary[]
  jobcpairparts                       jobcpairparts[]
  jobcpairreceivelog                  jobcpairreceivelog[]
  jobcpairissuelog                    jobcpairissuelog[]
  reportcolumnpreferences             reportcolumnpreferences[]
  useractivitylogs                    useractivitylogs[]

  @@index([branchid], map: "idx_jsl_branches")
}

model cities {
  recno                             Int            @id @default(autoincrement())
  tenantid                          Int?
  name                              String?
  countryid                         Int?
  createdby                         Int?
  createdat                         DateTime?      @db.Timestamp(6)
  lastupdatedby                     Int?
  lastupdatedat                     DateTime?      @db.Timestamp(6)
  isactive                          Boolean?
  areas                             areas[]
  countries                         countries?     @relation(fields: [countryid], references: [recno], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_countries")
  users_cities_createdbyTousers     users?         @relation("cities_createdbyTousers", fields: [createdby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_createdby")
  users_cities_lastupdatedbyTousers users?         @relation("cities_lastupdatedbyTousers", fields: [lastupdatedby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_lastupdatedby")
  organizations                     organizations? @relation(fields: [tenantid], references: [tenantid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_tenant")
  customers                         customers[]
  customeraddresses                 customeraddresses[]
  job                               job[]

  @@index([recno], map: "idx_jsl_cities")
}

model countries {
  recno                                Int            @id @default(autoincrement())
  tenantid                             Int?
  name                                 String?
  createdby                            Int?
  createdat                            DateTime?      @db.Timestamp(6)
  lastupdatedby                        Int?
  lastupdatedat                        DateTime?      @db.Timestamp(6)
  isactive                             Boolean?
  cities                               cities[]
  users_countries_createdbyTousers     users?         @relation("countries_createdbyTousers", fields: [createdby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_createdby")
  users_countries_lastupdatedbyTousers users?         @relation("countries_lastupdatedbyTousers", fields: [lastupdatedby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_lastupdatedby")
  organizations                        organizations? @relation(fields: [tenantid], references: [tenantid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_tenant")
  customers                            customers[]
  customeraddresses                    customeraddresses[]

  @@index([recno], map: "idx_jsl_countries")
}

model customers {
  customerid                           Int            @id @default(autoincrement())
  tenantid                             Int?
  branchid                             Int?
  name                                 String?
  email                                String?
  contactno                            String?
  address                              String?        @db.VarChar(255)
  isactive                             Boolean?
  createdby                            Int?
  createdat                            DateTime?      @db.Timestamp(6)
  lastupdatedby                        Int?
  lastupdatedat                        DateTime?      @db.Timestamp(6)
  country                              Int?
  city                                 Int?
  area                                 Int?
  areas                                areas?         @relation(fields: [area], references: [recno], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_areas")
  branches                             branches?      @relation(fields: [branchid], references: [branchid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_branch")
  cities                               cities?        @relation(fields: [city], references: [recno], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_cities")
  countries                            countries?     @relation(fields: [country], references: [recno], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_countries")
  users_customers_createdbyTousers     users?         @relation("customers_createdbyTousers", fields: [createdby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_createdby")
  users_customers_lastupdatedbyTousers users?         @relation("customers_lastupdatedbyTousers", fields: [lastupdatedby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_lastupdatedby")
  organizations                        organizations? @relation(fields: [tenantid], references: [tenantid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_tenant")
  job                                  job[]
  customeraddresses                    customeraddresses[]

  @@unique([tenantid, branchid, contactno], map: "uq_customers_tenant_branch_contactno")
  @@index([customerid], map: "idx_jsl_customers")
}

model customeraddresses {
  recno                                Int            @id @default(autoincrement())
  customerid                           Int
  tenantid                             Int?
  branchid                             Int?
  country                              Int?
  city                                 Int?
  area                                 Int?
  address                              String?        @db.VarChar(255)
  createdby                            Int?
  createdat                            DateTime?      @db.Timestamp(6)
  lastupdatedby                        Int?
  lastupdatedat                        DateTime?      @db.Timestamp(6)
  customers                            customers      @relation(fields: [customerid], references: [customerid], onDelete: NoAction, onUpdate: NoAction, map: "fk_customeraddresses_customer")
  branches                             branches?      @relation(fields: [branchid], references: [branchid], onDelete: NoAction, onUpdate: NoAction, map: "fk_customeraddresses_branch")
  organizations                        organizations? @relation(fields: [tenantid], references: [tenantid], onDelete: NoAction, onUpdate: NoAction, map: "fk_customeraddresses_tenant")
  countries                            countries?     @relation(fields: [country], references: [recno], onDelete: NoAction, onUpdate: NoAction, map: "fk_customeraddresses_country")
  cities                               cities?        @relation(fields: [city], references: [recno], onDelete: NoAction, onUpdate: NoAction, map: "fk_customeraddresses_city")
  areas                                areas?         @relation(fields: [area], references: [recno], onDelete: NoAction, onUpdate: NoAction, map: "fk_customeraddresses_area")
  users_customeraddresses_createdby    users?         @relation("customeraddresses_createdbyTousers", fields: [createdby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_customeraddresses_createdby")
  users_customeraddresses_lastupdatedby users?        @relation("customeraddresses_lastupdatedbyTousers", fields: [lastupdatedby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_customeraddresses_lastupdatedby")

  @@index([customerid], map: "idx_customeraddresses_customer")
  @@index([tenantid, branchid, customerid], map: "idx_customeraddresses_tenant_branch_customer")
}

model jobcategories {
  categoryid                               Int                @id @default(autoincrement())
  groupid                                  Int?
  tenantid                                 Int?
  branchid                                 Int?
  name                                     String?
  isactive                                 Boolean?
  color                                    String?            @db.VarChar(15)
  createdby                                Int?
  createdat                                DateTime?          @db.Timestamp(6)
  lastupdatedby                            Int?
  lastupdatedat                            DateTime?          @db.Timestamp(6)
  job                                      job[]
  branches                                 branches?          @relation(fields: [branchid], references: [branchid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_branch")
  users_jobcategories_createdbyTousers     users?             @relation("jobcategories_createdbyTousers", fields: [createdby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_createdby")
  jobgroups                                jobgroups?         @relation(fields: [groupid], references: [groupid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_group")
  users_jobcategories_lastupdatedbyTousers users?             @relation("jobcategories_lastupdatedbyTousers", fields: [lastupdatedby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_lastupdatedby")
  organizations                            organizations?     @relation(fields: [tenantid], references: [tenantid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_tenant")
  jobsubcategories                         jobsubcategories[]

  @@index([categoryid], map: "idx_jsl_jobcategories")
}

model jobgroups {
  groupid                              Int             @id @default(autoincrement())
  tenantid                             Int?
  branchid                             Int?
  name                                 String?
  isactive                             Boolean?
  color                                String?         @db.VarChar(15)
  createdby                            Int?
  createdat                            DateTime?       @db.Timestamp(6)
  lastupdatedby                        Int?
  lastupdatedat                        DateTime?       @db.Timestamp(6)
  jobcategories                        jobcategories[]
  job                                  job[]
  branches                             branches?       @relation(fields: [branchid], references: [branchid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_branch")
  users_jobgroups_createdbyTousers     users?          @relation("jobgroups_createdbyTousers", fields: [createdby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_createdby")
  users_jobgroups_lastupdatedbyTousers users?          @relation("jobgroups_lastupdatedbyTousers", fields: [lastupdatedby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_lastupdatedby")
  organizations                        organizations?  @relation(fields: [tenantid], references: [tenantid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_tenant")

  @@index([groupid], map: "idx_jsl_jobgroups")
}

model jobsubcategories {
  subcategoryid                               Int            @id @default(autoincrement())
  categoryid                                  Int?
  tenantid                                    Int?
  branchid                                    Int?
  defaultuser                                 Int?
  name                                        String?
  isactive                                    Boolean?
  color                                       String?        @db.VarChar(15)
  createdby                                   Int?
  createdat                                   DateTime?      @db.Timestamp(6)
  lastupdatedby                               Int?
  lastupdatedat                               DateTime?      @db.Timestamp(6)
  job                                         job[]
  branches                                    branches?      @relation(fields: [branchid], references: [branchid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_branch")
  jobcategories                               jobcategories? @relation(fields: [categoryid], references: [categoryid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_category")
  users_jobsubcategories_createdbyTousers     users?         @relation("jobsubcategories_createdbyTousers", fields: [createdby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_createdby")
  users_jobsubcategories_lastupdatedbyTousers users?         @relation("jobsubcategories_lastupdatedbyTousers", fields: [lastupdatedby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_lastupdatedby")
  organizations                               organizations? @relation(fields: [tenantid], references: [tenantid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_tenant")

  @@index([subcategoryid], map: "idx_jsl_jobsubcategories")
}

model organizations {
  tenantid                                 Int                     @id @default(autoincrement())
  organizationname                         String?
  phoneno                                  String?
  email                                    String?
  website                                  String?
  defaultcurrency                          Int?
  country                                  Int?
  city                                     Int?
  address                                  String?
  address2                                 String?
  logourl                                  String?
  istaxregistered                          Boolean?
  taxno                                    String?
  createdby                                Int?
  createdat                                DateTime?               @db.Timestamp(6)
  lastupdatedby                            Int?
  lastupdatedat                            DateTime?               @db.Timestamp(6)
  financialyeartype                        Int?                    @db.SmallInt
  roundingdigit                            Int?                    @db.SmallInt
  weektype                                 Int?                    @db.SmallInt
  areas                                    areas[]
  branches                                 branches[]
  cities                                   cities[]
  countries                                countries[]
  customers                                customers[]
  customeraddresses                        customeraddresses[]
  job                                      job[]
  jobaddonproducts                         jobaddonproducts[]
  jobassignmentlog                         jobassignmentlog[]
  jobattachments                           jobattachments[]
  jobcategories                            jobcategories[]
  jobcustomerremarkslog                    jobcustomerremarkslog[]
  jobcustomerfeedback                      jobcustomerfeedback[]
  jobdetails                               jobdetails[]
  jobgroups                                jobgroups[]
  jobproducts                              jobproducts[]
  jobservices                              jobservices[]
  jobstatuses                              jobstatuses[]
  jobstatuslog                             jobstatuslog[]
  jobquotationstatuslog                    jobquotationstatuslog[]
  jobsubcategories                         jobsubcategories[]
  jobtravelhistory                         jobtravelhistory[]
  jobworklhistory                          jobworklhistory[]
  users_organizations_createdbyTousers     users?                  @relation("organizations_createdbyTousers", fields: [createdby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_createdby")
  users_organizations_lastupdatedbyTousers users?                  @relation("organizations_lastupdatedbyTousers", fields: [lastupdatedby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_lastupdatedby")
  policies                                 policies[]
  products                                 products[]
  erpproducts                              erpproducts[]
  taxtypes                                 taxtypes[]
  deliverytypes                            deliverytypes[]
  expensetypes                             expensetypes[]
  jobtypes                                 jobtypes[]
  jobsources                               jobsources[]
  units                                    units[]
  brands                                   brands[]
  userorganizations                        userorganizations[]
  userpolicies                             userpolicies[]
  userrights                               userrights[]
  userssignuptokenlogs                     userssignuptokenlogs[]
  userlocations                            userlocations[]
  userattendancesession                    userattendancesession[]
  userattendancelog                        userattendancelog[]
  announcements                            announcements[]
  jobapprovalsettings                      jobapprovalsettings[]
  faceapprovalsettings                     faceapprovalsettings[]
  faceapprovalrequests                     faceapprovalrequests[]
  jobquotationsettings                     jobquotationsettings[]
  jobcashsettings                          jobcashsettings[]
  jobcollections                           jobcollections[]
  jobexpenses                              jobexpenses[]
  jobcpairsummary                          jobcpairsummary[]
  jobcpairparts                            jobcpairparts[]
  jobcpairreceivelog                       jobcpairreceivelog[]
  jobcpairissuelog                         jobcpairissuelog[]
  reportcolumnpreferences                  reportcolumnpreferences[]
  useractivitylogs                         useractivitylogs[]

  @@index([tenantid], map: "idx_jsl_organizations")
}

model policies {
  recno                               Int            @id @default(autoincrement())
  tenantid                            Int?
  createdby                           Int?
  createdat                           DateTime?      @db.Timestamp(6)
  lastupdatedby                       Int?
  updatedat                           DateTime?      @db.Timestamp(6)
  description                         String?
  isdefaultpolicy                     Boolean?
  users_policies_createdbyTousers     users?         @relation("policies_createdbyTousers", fields: [createdby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_createdby")
  users_policies_lastupdatedbyTousers users?         @relation("policies_lastupdatedbyTousers", fields: [lastupdatedby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_lastupdatedby")
  organizations                       organizations? @relation(fields: [tenantid], references: [tenantid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_tenant")
  userpolicies                        userpolicies[]
  userrights                          userrights[]

  @@index([recno], map: "idx_jsl_policies")
}

model products {
  productid                           Int                @id @default(autoincrement())
  tenantid                            Int?
  branchid                            Int?
  unitid                              Int?
  brandid                             Int?
  name                                String?
  hscode                              String?            @db.VarChar(20)
  barcode                             String?            @db.VarChar(50)
  erpcode                             String?            @db.VarChar(50)
  salerate                            Float?
  discountvalue                       Float?
  discounttype                        String?
  purchaserate                        Float?
  taxtypeid                           Int?
  isactive                            Boolean?
  isservice                           Boolean?
  managestock                         Boolean?
  enablecpairreceive                  Boolean?           @default(false)
  producttype                         String?            @db.VarChar(20)
  createdby                           Int?
  createdat                           DateTime?          @db.Timestamp(6)
  lastupdatedby                       Int?
  lastupdatedat                       DateTime?          @db.Timestamp(6)
  jobaddonproducts                    jobaddonproducts[]
  jobproducts                         jobproducts[]
  jobservices                         jobservices[]
  branches                            branches?          @relation(fields: [branchid], references: [branchid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_branch")
  taxtypes                            taxtypes?          @relation(fields: [taxtypeid], references: [recno], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_products_taxtypeid")
  units                               units?             @relation(fields: [unitid], references: [recno], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_products_unit")
  brands                              brands?            @relation(fields: [brandid], references: [recno], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_products_brand")
  users_products_createdbyTousers     users?             @relation("products_createdbyTousers", fields: [createdby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_createdby")
  users_products_lastupdatedbyTousers users?             @relation("products_lastupdatedbyTousers", fields: [lastupdatedby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_lastupdatedby")
  organizations                       organizations?     @relation(fields: [tenantid], references: [tenantid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_tenant")

  @@index([productid], map: "idx_jsl_products")
}

/// ERP product catalog — same shape as products except stock/service/tax fields.
model erpproducts {
  erpproductid                             Int            @id @default(autoincrement())
  tenantid                                 Int?
  branchid                                 Int?
  unitid                                   Int?
  brandid                                  Int?
  name                                     String?
  hscode                                   String?        @db.VarChar(20)
  barcode                                  String?        @db.VarChar(50)
  erpcode                                  String?        @db.VarChar(50)
  salerate                                 Float?
  discountvalue                            Float?
  discounttype                             String?
  purchaserate                             Float?
  isactive                                 Boolean?
  enablecpairreceive                       Boolean?       @default(false)
  producttype                              String?        @db.VarChar(20)
  createdby                                Int?
  createdat                                DateTime?      @db.Timestamp(6)
  lastupdatedby                            Int?
  lastupdatedat                            DateTime?      @db.Timestamp(6)
  branches                                 branches?      @relation(fields: [branchid], references: [branchid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_erpproducts_branch")
  units                                    units?         @relation(fields: [unitid], references: [recno], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_erpproducts_unit")
  brands                                   brands?        @relation(fields: [brandid], references: [recno], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_erpproducts_brand")
  users_erpproducts_createdbyTousers       users?         @relation("erpproducts_createdbyTousers", fields: [createdby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_erpproducts_createdby")
  users_erpproducts_lastupdatedbyTousers   users?         @relation("erpproducts_lastupdatedbyTousers", fields: [lastupdatedby], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_erpproducts_lastupdatedby")
  organizations                            organizations? @relation(fields: [tenantid], references: [tenantid], onDelete: NoAction, onUpdate: NoAction, map: "fk_jsl_erpproducts_tenant")
  job                                      job[]

  @@index([erpproductid], map: "idx_jsl_erpproducts")
}

model screens {
  screenid       Int          @id @default(autoincrement())
  screenname     String?
  screengroup    String?
  controllername String?
  createdby      Int?
  createdat      DateTime?    @db.Timestamp(6)
  lastupdatedby  Int?
  updatedat      DateTime?    @db.Timestamp(6)
  isvisible      Boolean?
  accessible     Boolean?
  userrights     userrights[]

  @@index([screenid], map: "idx_jsl_screens")
}

model userorganizations {
  recno                                        Int            @id @default(autoincrement())
  userid                                       Int?
  tenantid                                     Int?
  branchid                                     Int?
  createdby                                    Int?
  createdat                                    DateTime?      @db.Timestamp(6)
  lastupdatedby                                Int?
  lastupdatedat                                DateTime?      @db.Timestamp(6)
  isblocked                                    Boolean?
  blockedby                                    Int?
