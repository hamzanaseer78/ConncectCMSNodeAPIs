/// Per-user GraphQL report column chooser (JSON array stored in columnsjson).
model reportcolumnpreferences {
  recno         Int           @id @default(autoincrement())
  tenantid      Int
  branchid      Int
  userid        Int
  reportkey     String        @db.VarChar(100)
  columnsjson   String
  createdat     DateTime?     @db.Timestamp(6)
  lastupdatedat DateTime?     @db.Timestamp(6)
  branches      branches      @relation(fields: [branchid], references: [branchid], onDelete: NoAction, onUpdate: NoAction, map: "fk_reportcolumnprefs_branch")
  organizations organizations @relation(fields: [tenantid], references: [tenantid], onDelete: NoAction, onUpdate: NoAction, map: "fk_reportcolumnprefs_tenant")
  users         users         @relation(fields: [userid], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_reportcolumnprefs_user")

  @@unique([tenantid, branchid, userid, reportkey], map: "uq_reportcolumnprefs_scope")
  @@index([tenantid, branchid, userid], map: "idx_reportcolumnprefs_user")
}

model useractivitylogs {
  recno           Int                @id @default(autoincrement())
  tenantid        Int
  branchid        Int
  userid          Int?
  module          String             @db.VarChar(80)
  entityname      String?            @db.VarChar(255)
  entitycode      String?            @db.VarChar(100)
  jobid           Int?
  entityid        Int?
  action          UserActivityAction
  summary         String?
  metadata        Json?
  ipaddress       String?            @db.VarChar(100)
  useragent       String?            @db.VarChar(500)
  recordedat      DateTime           @default(now()) @db.Timestamp(6)
  branches        branches           @relation(fields: [branchid], references: [branchid], onDelete: NoAction, onUpdate: NoAction, map: "fk_useractivitylogs_branch")
  organizations   organizations      @relation(fields: [tenantid], references: [tenantid], onDelete: NoAction, onUpdate: NoAction, map: "fk_useractivitylogs_tenant")
  users           users?             @relation(fields: [userid], references: [userid], onDelete: NoAction, onUpdate: NoAction, map: "fk_useractivitylogs_user")
  job             job?               @relation(fields: [jobid], references: [recno], onDelete: NoAction, onUpdate: NoAction, map: "fk_useractivitylogs_job")

  @@index([tenantid, branchid, recordedat(sort: Desc)], map: "idx_useractivitylogs_tenant_branch_time")
  @@index([userid, recordedat(sort: Desc)], map: "idx_useractivitylogs_user_time")
  @@index([module, recordedat(sort: Desc)], map: "idx_useractivitylogs_module_time")
  @@index([jobid, recordedat(sort: Desc)], map: "idx_useractivitylogs_job_time")
  @@index([action, recordedat(sort: Desc)], map: "idx_useractivitylogs_action_time")
}
