# ========================================
# Database Configuration
# ========================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:Qwert12345@127.0.0.1:5432/connectcms"

# ========================================
# Security Configuration
# ========================================
# JWT Secret Key - MUST BE SET IN PRODUCTION
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-key-change-this-in-production"

# JWT Token Expiration Time
JWT_EXPIRES_IN="7d"

# Signup Token Expiration (in minutes)
SIGNUP_TOKEN_EXPIRES_MINUTES="30"

# Password reset email token expiration (in minutes)
PASSWORD_RESET_EXPIRES_MINUTES="30"

# Profile image upload max size in bytes (default 5MB)
# PROFILE_IMAGE_MAX_BYTES=5242880

# ========================================
# Server Configuration
# ========================================
# Application environment
NODE_ENV="development"

# GraphQL playground (Altair) and embedded Apollo Studio — enable /graphql/playground and /graphql/studio in production
GRAPHQL_PLAYGROUND_ENABLED=false

# Server port
PORT="3000"

# ========================================
# Seq Structured Logging
# ========================================
# Public URL for Seq UI + log ingest (API posts to {SEQ_SERVER_URL}/api/events/raw)
SEQ_SERVER_URL="https://cmsapis.lightclouderp.com/logs"
# Local Seq instance the Node app proxies /logs to (host port maps to container :80)
SEQ_UPSTREAM_URL="http://127.0.0.1:5341"
SEQ_PROXY_ENABLED=true
# Optional API key if ingest authentication is enabled on Seq
# SEQ_API_KEY=""
SEQ_APPLICATION_NAME="ConnectCMS-API"
SEQ_LOGGING_ENABLED=true
# SEQ_FLUSH_INTERVAL_MS=2000
# SEQ_BATCH_SIZE=50

# Max multipart upload size in bytes (default 25MB if unset)
# UPLOAD_MAX_FILE_BYTES=26214400

# CORS: single origin, comma-separated list, or * to allow all origins (no trailing slash)
# CORS_ALLOW_ALL=true reflects any browser Origin (use for dev or SPA on another port)
CORS_ORIGIN="http://72.60.236.155"
CORS_ALLOW_ALL=true

# Application URL (used in email links and redirects)
APP_URL="http://72.60.236.155"

# ========================================
# Email Configuration
# ========================================
# Email service type: "smtp" or "sendgrid"
EMAIL_PROVIDER="smtp"

# SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="noreply@yourdomain.com"

# Sendgrid Configuration (alternative to SMTP)
# SENDGRID_API_KEY="your-sendgrid-api-key"
# SENDGRID_FROM_EMAIL="noreply@yourdomain.com"

# ========================================
# Firebase Push Notifications (FCM)
# ========================================
# Download service account JSON from Firebase Console → Project settings → Service accounts
# Place the file outside git (e.g. config/firebase/serviceAccountKey.json) and set path:
FIREBASE_ENABLED="true"
FIREBASE_SERVICE_ACCOUNT_PATH="config/firebase/serviceAccountKey.json"
FIREBASE_DATABASE_URL="https://hrms-ce25f.firebaseio.com"
# Firestore collection for persisted user inbox notifications (case-sensitive)
FIREBASE_NOTIFICATIONS_COLLECTION="cmsusernotifications"
# First-time setup: create composite indexes — open the index URL from a 503 response,
# or run: npx firebase deploy --only firestore:indexes --project hrms-ce25f

# Alternative: inline JSON (single line) for servers without a key file — do not commit
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'

# ========================================
# MCP (Cursor + Gemini CLI)
# ========================================
# Stdio MCP server: npm run mcp:start
# Config: .cursor/mcp.json (Cursor) and .gemini/settings.json (Gemini CLI)
# Provide ONE of: MCP_JWT, or MCP_EMAIL + MCP_PASSWORD, or call cms_login from the client.
# MCP_EMAIL=""
# MCP_PASSWORD=""
# MCP_JWT=""
# Optional: GEMINI_API_KEY for a future Gemini API chat bridge (not required for Gemini CLI MCP)
# GEMINI_API_KEY=""

